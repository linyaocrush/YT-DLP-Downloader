<Window x:Class="YtDlpDownloader.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:YtDlpDownloader.App.Views"
        Title="{Binding WindowTitle}"
        Height="760" Width="1120"
        MinHeight="640" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <TabControl Margin="8">
        <TabItem Header="下载">
            <views:DownloadView DataContext="{Binding Download}" />
        </TabItem>
        <TabItem Header="设置">
            <views:SettingsView DataContext="{Binding Settings}" />
        </TabItem>
    </TabControl>
</Window>
