<Window x:Class="YtDlpDownloader.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:YtDlpDownloader.App.Views"
        Title="{Binding WindowTitle}"
        Height="780" Width="1160"
        MinHeight="660" MinWidth="940"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen">
    <TabControl Margin="18,10,18,18">
        <TabItem Header="下载">
            <views:DownloadView DataContext="{Binding Download}" />
        </TabItem>
        <TabItem Header="设置">
            <views:SettingsView DataContext="{Binding Settings}" />
        </TabItem>
    </TabControl>
</Window>
