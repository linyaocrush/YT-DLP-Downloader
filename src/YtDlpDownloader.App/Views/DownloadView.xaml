<UserControl x:Class="YtDlpDownloader.App.Views.DownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer x:Name="RootScroll"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
    <Grid x:Name="Root" MinHeight="{Binding ActualHeight, ElementName=RootScroll}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="{Binding DataContext.IsManualMode, ElementName=Root, Converter={StaticResource BoolToStar}}" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: download settings -->
        <Border Grid.Row="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- URL -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="视频链接"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox Grid.Column="1"
                             Margin="8,0"
                             Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="2"
                            Content="解析"
                            Style="{StaticResource AccentButton}"
                            Command="{Binding ParseCommand}" />
                </Grid>

                <!-- save folder -->
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="保存到"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox Grid.Column="1"
                             Margin="8,0"
                             Text="{Binding DownloadDirectory, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{Binding DownloadDirectory}" />
                    <Button Grid.Column="2"
                            Content="浏览…"
                            Command="{Binding BrowseFolderCommand}" />
                </Grid>

                <!-- output file name -->
                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="文件名"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Margin="8,0"
                                    VerticalAlignment="Center">
                            <RadioButton Content="模板模式"
                                         Margin="0,0,20,0"
                                         GroupName="NameMode"
                                         IsChecked="{Binding IsTemplateNameMode}" />
                            <RadioButton Content="文件名模式"
                                         GroupName="NameMode"
                                         IsChecked="{Binding IsFixedNameMode}" />
                        </StackPanel>
                    </Grid>

                    <!-- template preview (read-only) -->
                    <TextBox Margin="104,8,8,0"
                             Text="{Binding OutputTemplate, Mode=OneWay}"
                             IsReadOnly="True"
                             Background="#F7F7F7"
                             FontFamily="{StaticResource MonoFont}"
                             FontSize="13"
                             Visibility="{Binding IsTemplateNameMode, Converter={StaticResource BoolToVis}}" />

                    <!-- fixed file name input -->
                    <TextBox Margin="104,8,8,0"
                             Text="{Binding FixedFileName, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsFixedNameMode, Converter={StaticResource BoolToVis}}" />

                    <!-- template field chips -->
                    <ItemsControl Margin="104,10,8,0"
                                  ItemsSource="{Binding OutputTemplateFields}"
                                  Visibility="{Binding IsTemplateNameMode, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Style="{StaticResource ChipToggle}"
                                              Content="{Binding Label}"
                                              ToolTip="{Binding Token}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Margin="104,4,8,0"
                               Text="{Binding OutputNameHint}"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <!-- cookie file (dropdown populated from the configured folder) -->
                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Cookie 文件"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <ComboBox Grid.Column="1"
                              Margin="8,0"
                              Style="{StaticResource AppComboBox}"
                              ItemsSource="{Binding CookieOptions}"
                              SelectedItem="{Binding SelectedCookie}"
                              IsEnabled="{Binding HasCookieFolder}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="2"
                            Content="重新扫描"
                            VerticalAlignment="Center"
                            Command="{Binding RefreshCookiesCommand}"
                            ToolTip="重新扫描 Cookie 文件夹" />
                </Grid>

                <TextBlock Grid.Row="4"
                           Margin="104,6,8,0"
                           Text="{Binding CookieHint}"
                           TextWrapping="Wrap"
                           FontSize="11">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CookieNeedsSetup}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- download mode + actions -->
                <Grid Grid.Row="5" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="下载方式"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Content="自动选择（最高画质 / 音质并合成）"
                                     Margin="0,0,20,0"
                                     GroupName="DownloadMode"
                                     IsChecked="{Binding IsAutoMode}" />
                        <RadioButton Content="手动选择"
                                     GroupName="DownloadMode"
                                     IsChecked="{Binding IsManualMode}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,16,0">
                        <TextBlock Text="线程数"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Width="56"
                                 Text="{Binding DownloadThreads, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="同时下载的分片数（1-64），默认 4" />
                    </StackPanel>
                    <StackPanel Grid.Column="4"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Content="开始下载"
                                Style="{StaticResource AccentButton}"
                                Command="{Binding DownloadCommand}" />
                        <Button Content="取消"
                                Margin="8,0,0,0"
                                Command="{Binding CancelCommand}" />
                    </StackPanel>
                    <TextBlock Grid.Column="5"
                               Text="{Binding YtDlpStatus}"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </Grid>

                <!-- download kind selector (default / video only / audio only) -->
                <Grid Grid.Row="6" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="下载内容"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <Border Grid.Column="1"
                            Width="260"
                            HorizontalAlignment="Left"
                            Background="{StaticResource SubtleFillBrush}"
                            BorderBrush="{StaticResource ControlBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="3">
                        <Grid>
                            <Border x:Name="KindThumb"
                                    Width="84"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch"
                                    CornerRadius="6"
                                    Background="{StaticResource CardBackgroundBrush}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8"
                                                      ShadowDepth="1"
                                                      Opacity="0.18"
                                                      Color="#000000" />
                                </Border.Effect>
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="KindThumbTransform" X="0" />
                                </Border.RenderTransform>
                            </Border>
                            <UniformGrid Columns="3" Rows="1">
                                <RadioButton Content="默认"
                                             Style="{StaticResource SegmentRadioButton}"
                                             GroupName="DownloadKind"
                                             IsChecked="{Binding IsDefaultKind}">
                                    <RadioButton.Triggers>
                                        <EventTrigger RoutedEvent="ToggleButton.Checked">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="KindThumbTransform"
                                                                     Storyboard.TargetProperty="X"
                                                                     To="0"
                                                                     Duration="0:0:0.25">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </RadioButton.Triggers>
                                </RadioButton>
                                <RadioButton Content="仅视频"
                                             Style="{StaticResource SegmentRadioButton}"
                                             GroupName="DownloadKind"
                                             IsChecked="{Binding IsVideoOnlyKind}">
                                    <RadioButton.Triggers>
                                        <EventTrigger RoutedEvent="ToggleButton.Checked">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="KindThumbTransform"
                                                                     Storyboard.TargetProperty="X"
                                                                     To="84"
                                                                     Duration="0:0:0.25">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </RadioButton.Triggers>
                                </RadioButton>
                                <RadioButton Content="仅音频"
                                             Style="{StaticResource SegmentRadioButton}"
                                             GroupName="DownloadKind"
                                             IsChecked="{Binding IsAudioOnlyKind}">
                                    <RadioButton.Triggers>
                                        <EventTrigger RoutedEvent="ToggleButton.Checked">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="KindThumbTransform"
                                                                     Storyboard.TargetProperty="X"
                                                                     To="168"
                                                                     Duration="0:0:0.25">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </RadioButton.Triggers>
                                </RadioButton>
                            </UniformGrid>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                    <!-- resolution preference (auto mode only) -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="20,0,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Opacity" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAutoMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0" To="1"
                                                                     Duration="0:0:0.22">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="分辨率"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <ComboBox Width="132"
                                  Style="{StaticResource AppComboBox}"
                                  ItemsSource="{Binding ResolutionOptions}"
                                  SelectedItem="{Binding SelectedResolution}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- proxy status indicator for the current URL -->
                    <Border Margin="16,0,0,0"
                            Padding="10,4"
                            CornerRadius="12"
                            VerticalAlignment="Center"
                            Background="{StaticResource SubtleFillBrush}"
                            ToolTip="{Binding ProxyStatusDetail}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8"
                                     Height="8"
                                     VerticalAlignment="Center"
                                     Fill="{Binding ProxyStatusBrush}" />
                            <TextBlock Text="{Binding ProxyStatusText}"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="12.5"
                                       Foreground="{Binding ProxyStatusBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Row 1: parsed media info (cover + title), above the source lists -->
        <Border Grid.Row="1"
                Style="{StaticResource Card}"
                Margin="0,12,0,0"
                Visibility="{Binding HasMediaInfo, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="160" Height="90"
                        CornerRadius="6"
                        Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <StackPanel Grid.Column="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding VideoTitle}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding MetaText}"
                               Margin="0,6,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 2: source tables (manual selection only) -->
        <Grid Grid.Row="2"
              MinHeight="220"
              Margin="0,12,0,0"
              Visibility="{Binding IsManualMode, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding ShowVideoSources, Converter={StaticResource BoolToStar}}" />
                <ColumnDefinition Width="{Binding ShowBothSources, Converter={StaticResource BoolToStar}, ConverterParameter=12}" />
                <ColumnDefinition Width="{Binding ShowAudioSources, Converter={StaticResource BoolToStar}}" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource Card}"
                    Padding="12"
                    Visibility="{Binding ShowVideoSources, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="视频源"
                               FontWeight="SemiBold"
                               Margin="4,0,0,8" />
                    <DataGrid ItemsSource="{Binding VideoSources}"
                              SelectedItem="{Binding SelectedVideo}"
                              MaxHeight="360">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="格式 ID" Binding="{Binding FormatId}" Width="70" />
                            <DataGridTextColumn Header="分辨率" Binding="{Binding Resolution}" Width="96" />
                            <DataGridTextColumn Header="帧率" Binding="{Binding FpsText}" Width="52" />
                            <DataGridTextColumn Header="码率" Binding="{Binding BitrateText}" Width="104" />
                            <DataGridTextColumn Header="视频编码" Binding="{Binding Codec}" Width="*" />
                            <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="96" />
                            <DataGridTextColumn Header="容器" Binding="{Binding Container}" Width="58" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource Card}"
                    Padding="12"
                    Visibility="{Binding ShowAudioSources, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="音频源"
                               FontWeight="SemiBold"
                               Margin="4,0,0,8" />
                    <DataGrid ItemsSource="{Binding AudioSources}"
                              SelectedItem="{Binding SelectedAudio}"
                              MaxHeight="360">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="格式 ID" Binding="{Binding FormatId}" Width="70" />
                            <DataGridTextColumn Header="码率" Binding="{Binding BitrateText}" Width="104" />
                            <DataGridTextColumn Header="音频编码" Binding="{Binding Codec}" Width="*" />
                            <DataGridTextColumn Header="容器" Binding="{Binding Container}" Width="58" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Row 3: status + selection hint -->
        <Grid Grid.Row="3" Margin="2,12,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding StatusText}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="{Binding SelectionHint}"
                       TextWrapping="Wrap"
                       MaxWidth="360"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontStyle="Italic"
                       Margin="16,0,0,0"
                       VerticalAlignment="Top" />
        </Grid>

        <!-- Row 4: progress + log -->
        <Grid Grid.Row="4" Margin="2,10,2,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0"
                  Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar Grid.Column="0"
                             Margin="0,0,10,0"
                             VerticalAlignment="Center"
                             Minimum="0" Maximum="100"
                             Value="{Binding Progress, Mode=OneWay}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ProgressText}"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </Grid>
            <Expander Grid.Row="1"
                      Header="日志"
                      Margin="0,10,0,0"
                      IsExpanded="False">
                <ListBox ItemsSource="{Binding Logs}"
                         Height="180"
                         FontFamily="{StaticResource MonoFont}"
                         FontSize="11"
                         HorizontalContentAlignment="Stretch"
                         VirtualizingPanel.ScrollUnit="Pixel" />
            </Expander>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
