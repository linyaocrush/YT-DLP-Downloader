<UserControl x:Class="YtDlpDownloader.App.Views.DownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: download settings -->
        <Border Grid.Row="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- URL -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="视频链接"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox Grid.Column="1"
                             Margin="8,0"
                             Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="2"
                            Content="解析"
                            Style="{StaticResource AccentButton}"
                            Command="{Binding ParseCommand}" />
                </Grid>

                <!-- save folder -->
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="保存到"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox Grid.Column="1"
                             Margin="8,0"
                             Text="{Binding DownloadDirectory, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{Binding DownloadDirectory}" />
                    <Button Grid.Column="2"
                            Content="浏览…"
                            Command="{Binding BrowseFolderCommand}" />
                </Grid>

                <!-- cookie file -->
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Cookie 文件"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox Grid.Column="1"
                             Margin="8,0"
                             Text="{Binding CookieFile, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{Binding CookieFile}" />
                    <Button Grid.Column="2"
                            Content="浏览…"
                            VerticalAlignment="Center"
                            Command="{Binding BrowseCookieFileCommand}" />
                    <Button Grid.Column="3"
                            Content="清除"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Command="{Binding ClearCookieFileCommand}" />
                </Grid>

                <TextBlock Grid.Row="3"
                           Margin="80,6,8,0"
                           Text="可选：用于需要登录或年龄限制的视频，一般为 Netscape 格式的 txt 文件"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}" />

                <!-- download mode + actions -->
                <Grid Grid.Row="4" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="下载方式"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Content="自动选择（最高画质 / 音质并合成）"
                                     Margin="0,0,20,0"
                                     GroupName="DownloadMode"
                                     IsChecked="{Binding IsAutoMode}" />
                        <RadioButton Content="手动选择"
                                     GroupName="DownloadMode"
                                     IsChecked="{Binding IsManualMode}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,16,0">
                        <TextBlock Text="线程数"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Width="56"
                                 Text="{Binding DownloadThreads, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="同时下载的分片数（1-64），默认 4" />
                    </StackPanel>
                    <StackPanel Grid.Column="4"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Content="开始下载"
                                Style="{StaticResource AccentButton}"
                                Command="{Binding DownloadCommand}" />
                        <Button Content="取消"
                                Margin="8,0,0,0"
                                Command="{Binding CancelCommand}" />
                    </StackPanel>
                    <TextBlock Grid.Column="5"
                               Text="{Binding YtDlpStatus}"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </Grid>
            </Grid>
        </Border>

        <!-- Row 1: parsed media info (cover + title), above the source lists -->
        <Border Grid.Row="1"
                Style="{StaticResource Card}"
                Margin="0,12,0,0"
                Visibility="{Binding HasMediaInfo, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="160" Height="90"
                        CornerRadius="6"
                        Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <StackPanel Grid.Column="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding VideoTitle}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding MetaText}"
                               Margin="0,6,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 2: source tables -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="视频源"
                               FontWeight="SemiBold"
                               Margin="4,0,0,8" />
                    <DataGrid ItemsSource="{Binding VideoSources}"
                              SelectedItem="{Binding SelectedVideo}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="格式 ID" Binding="{Binding FormatId}" Width="70" />
                            <DataGridTextColumn Header="分辨率" Binding="{Binding Resolution}" Width="96" />
                            <DataGridTextColumn Header="帧率" Binding="{Binding FpsText}" Width="52" />
                            <DataGridTextColumn Header="码率" Binding="{Binding BitrateText}" Width="104" />
                            <DataGridTextColumn Header="视频编码" Binding="{Binding Codec}" Width="*" />
                            <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="96" />
                            <DataGridTextColumn Header="容器" Binding="{Binding Container}" Width="58" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="音频源"
                               FontWeight="SemiBold"
                               Margin="4,0,0,8" />
                    <DataGrid ItemsSource="{Binding AudioSources}"
                              SelectedItem="{Binding SelectedAudio}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="格式 ID" Binding="{Binding FormatId}" Width="70" />
                            <DataGridTextColumn Header="码率" Binding="{Binding BitrateText}" Width="104" />
                            <DataGridTextColumn Header="音频编码" Binding="{Binding Codec}" Width="*" />
                            <DataGridTextColumn Header="容器" Binding="{Binding Container}" Width="58" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Row 3: status + selection hint -->
        <Grid Grid.Row="3" Margin="2,12,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding StatusText}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="{Binding SelectionHint}"
                       TextWrapping="Wrap"
                       MaxWidth="360"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontStyle="Italic"
                       Margin="16,0,0,0"
                       VerticalAlignment="Top" />
        </Grid>

        <!-- Row 4: progress + log -->
        <Grid Grid.Row="4" Margin="2,10,2,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0"
                  Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar Grid.Column="0"
                             Margin="0,0,10,0"
                             VerticalAlignment="Center"
                             Minimum="0" Maximum="100"
                             Value="{Binding Progress, Mode=OneWay}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ProgressText}"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </Grid>
            <Expander Grid.Row="1"
                      Header="日志"
                      Margin="0,10,0,0"
                      IsExpanded="False">
                <ListBox ItemsSource="{Binding Logs}"
                         Height="180"
                         FontFamily="{StaticResource MonoFont}"
                         FontSize="11"
                         HorizontalContentAlignment="Stretch"
                         VirtualizingPanel.ScrollUnit="Pixel" />
            </Expander>
        </Grid>
    </Grid>
</UserControl>
