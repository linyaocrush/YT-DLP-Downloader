<UserControl x:Class="YtDlpDownloader.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <GroupBox Header="yt-dlp 配置" Padding="12">
                <StackPanel>
                    <TextBlock Text="yt-dlp 路径" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Padding="4,5"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding YtDlpPath, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="yt-dlp.exe 的完整路径，例如 D:\tools\yt-dlp.exe" />
                        <Button Grid.Column="1"
                                Content="浏览…"
                                Padding="10,5"
                                Margin="8,0,0,0"
                                Command="{Binding BrowseCommand}" />
                        <Button Grid.Column="2"
                                Content="重新检测"
                                Padding="10,5"
                                Margin="8,0,0,0"
                                Command="{Binding RescanCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding StatusText}"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               Foreground="Gray">
                        <Run Text="说明：程序启动时会先在系统 PATH 中查找 yt-dlp.exe，找到则自动填入；找不到时请点击「浏览…」手动选择。合成音视频时需要 ffmpeg（请确保其已加入 PATH）。" />
                    </TextBlock>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="关于" Margin="0,16,0,0" Padding="12">
                <TextBlock TextWrapping="Wrap"
                           Text="本工具是对本地 yt-dlp / ffmpeg 的图形化封装，不内置或下载任何外部程序。链接与音视频源均直接解析自你提供的 URL。" />
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
