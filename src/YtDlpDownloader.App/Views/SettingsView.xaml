<UserControl x:Class="YtDlpDownloader.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="设置"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Margin="2,0,0,14" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="yt-dlp 路径"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <TextBlock Text="用于解析视频信息与下载。程序启动时会先从系统 PATH 中自动查找 yt-dlp.exe。"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding YtDlpPath, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="yt-dlp.exe 的完整路径，例如 D:\tools\yt-dlp.exe" />
                        <Button Grid.Column="1"
                                Content="浏览…"
                                Margin="8,0,0,0"
                                Command="{Binding BrowseCommand}" />
                        <Button Grid.Column="2"
                                Content="重新检测"
                                Margin="8,0,0,0"
                                Command="{Binding RescanCommand}" />
                    </Grid>

                    <Border Margin="0,14,0,0"
                            Padding="12,10"
                            CornerRadius="6"
                            Background="{StaticResource AccentSoftBrush}">
                        <TextBlock Text="{Binding StatusText}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </Border>

                    <TextBlock Margin="0,14,0,0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}">
                        <Run Text="合成音视频时需要 ffmpeg，请确保 ffmpeg 已加入系统 PATH。" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="关于"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="本工具是对本地 yt-dlp / ffmpeg 的图形化封装，不内置或下载任何外部程序。链接与音视频源均直接解析自你提供的 URL。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
