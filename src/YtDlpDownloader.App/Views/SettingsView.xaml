<UserControl x:Class="YtDlpDownloader.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="设置"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Margin="2,0,0,14" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="网络代理"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="开启后，下载与解析会按名单规则自动为 yt-dlp 添加 --proxy 参数。总开关关闭时永远不添加。"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1"
                                      Style="{StaticResource AppSwitch}"
                                      VerticalAlignment="Top"
                                      Margin="12,2,0,0"
                                      IsChecked="{Binding ProxyEnabled}"
                                      ToolTip="代理总开关" />
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="协议"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <ComboBox Grid.Column="1"
                                  Width="100"
                                  Margin="8,0,0,0"
                                  Style="{StaticResource AppComboBox}"
                                  ItemsSource="{Binding ProxyProtocolOptions}"
                                  SelectedItem="{Binding SelectedProxyProtocol}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Grid.Column="3"
                                   Text="IP / 主机"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Grid.Column="4"
                                 Margin="8,0"
                                 Text="{Binding ProxyHost, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="例如 127.0.0.1 或 proxy.example.com" />
                        <TextBlock Grid.Column="6"
                                   Text="端口"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Grid.Column="7"
                                 Width="84"
                                 Margin="8,0,0,0"
                                 Text="{Binding ProxyPort, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="1-65535，例如 7890" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="名单模式"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <RadioButton Content="黑名单（名单内的网站不使用代理）"
                                     GroupName="ProxyListMode"
                                     Margin="0,0,20,0"
                                     IsChecked="{Binding IsBlacklistMode}" />
                        <RadioButton Content="白名单（仅名单内的网站使用代理）"
                                     GroupName="ProxyListMode"
                                     IsChecked="{Binding IsWhitelistMode}" />
                    </StackPanel>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding NewProxySite, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="例如 https://www.youtube.com/" />
                        <Button Grid.Column="1"
                                Content="添加网站"
                                Margin="8,0,0,0"
                                Command="{Binding AddProxySiteCommand}" />
                    </Grid>

                    <ItemsControl Margin="0,10,0,0"
                                  ItemsSource="{Binding ProxySites}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource AccentSoftBrush}"
                                        BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="13"
                                        Padding="10,4"
                                        Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource AccentPressedBrush}" />
                                        <Button Content="✕"
                                                Width="18"
                                                Height="18"
                                                Padding="0"
                                                Margin="8,0,0,0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="{StaticResource AccentPressedBrush}"
                                                Command="{Binding DataContext.RemoveProxySiteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="移除该网站" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Margin="0,10,0,0"
                               Text="{Binding ProxyStatus}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="yt-dlp 路径"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <TextBlock Text="用于解析视频信息与下载。程序启动时会先从系统 PATH 中自动查找 yt-dlp.exe。"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding YtDlpPath, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="yt-dlp.exe 的完整路径，例如 D:\tools\yt-dlp.exe" />
                        <Button Grid.Column="1"
                                Content="浏览…"
                                Margin="8,0,0,0"
                                Command="{Binding BrowseCommand}" />
                        <Button Grid.Column="2"
                                Content="重新检测"
                                Margin="8,0,0,0"
                                Command="{Binding RescanCommand}" />
                    </Grid>

                    <Border Margin="0,14,0,0"
                            Padding="12,10"
                            CornerRadius="6"
                            Background="{StaticResource AccentSoftBrush}">
                        <TextBlock Text="{Binding StatusText}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="ffmpeg 路径"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <TextBlock Text="合成音视频、转换格式时需要 ffmpeg。程序会优先从系统 PATH 中自动查找 ffmpeg.exe；未找到时可在此手动指定。"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" />

                    <Grid Margin="0,14,0,0"
                          Visibility="{Binding ShowFfmpegManualControls, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding FfmpegPath, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="ffmpeg.exe 的完整路径，例如 D:\tools\ffmpeg.exe" />
                        <Button Grid.Column="1"
                                Content="浏览…"
                                Margin="8,0,0,0"
                                Command="{Binding BrowseFfmpegCommand}" />
                        <Button Grid.Column="2"
                                Content="清除"
                                Margin="8,0,0,0"
                                Command="{Binding ClearFfmpegCommand}" />
                    </Grid>

                    <Border Margin="0,14,0,0"
                            Padding="12,10"
                            CornerRadius="6"
                            Background="{StaticResource AccentSoftBrush}">
                        <TextBlock Text="{Binding FfmpegStatus}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Cookie 文件夹"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <TextBlock Text="选择一个文件夹，程序会自动识别其中的所有 Cookie 文件，并在下载页以下拉列表的形式供你选择。未设置时下载页将不使用 Cookie。"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding CookieFolder, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{Binding CookieFolder}" />
                        <Button Grid.Column="1"
                                Content="浏览…"
                                Margin="8,0,0,0"
                                Command="{Binding BrowseCookieFolderCommand}" />
                        <Button Grid.Column="2"
                                Content="清除"
                                Margin="8,0,0,0"
                                Command="{Binding ClearCookieFolderCommand}" />
                    </Grid>

                    <TextBlock Margin="0,10,0,0"
                               Text="{Binding CookieFolderStatus}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="关于"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="本工具是对本地 yt-dlp / ffmpeg 的图形化封装，不内置或下载任何外部程序。链接与音视频源均直接解析自你提供的 URL。" />
                    <TextBlock Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Copyright © 2026 凛ふわ狐" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
