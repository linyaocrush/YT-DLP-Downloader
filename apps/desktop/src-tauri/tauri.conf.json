{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YtDlpDownloader",
  "version": "0.1.0",
  "identifier": "com.ytdlpdownloader.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "YtDlp 下载器",
        "width": 1160,
        "height": 780,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["../../../assets/logo.ico"]
  }
}